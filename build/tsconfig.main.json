{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "../src",
    "outDir": "../dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": [
    "../src/main/**/*.ts",
    "../src/database/**/*.ts",
    "../src/shared/**/*.ts"
  ],
  "exclude": [
    "../dist",
    "../node_modules"
  ]
}