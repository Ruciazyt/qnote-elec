# See http://help.github.com/ignore-files/ for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/build
!/build/
!/build/tsconfig.main.json
!/build/tsconfig.preload.json
!/build/electron-builder.json

# tsc 越界编译时，会把 rootDir 覆盖不到的源文件的 .js 直接吐在源码旁边
# （例如 src/shared/noteTypes.js）。这类产物既不能进仓库，也不能留在 src 下 ——
# Vite 解析无扩展名 import 时 .js 优先于 .ts，会抓到这份陈旧产物导致打包失败。
src/**/*.js
src/**/*.js.map
!src/renderer/postcss.config.js
!src/renderer/tailwind.config.js
# macOS 打包图标（由 scripts/build/generate-icons.js 从 icon.svg 生成）
build/icon.icns
# 运行时图标（托盘 / 窗口图标，macOS 与 Linux 用 PNG，Windows 用 icon.ico）
resources/icon.png
resources/icon-tray.png
*.7z
*.zip
*.tar.gz
*.rar

# Node
node_modules/
# pnpm 内容寻址存储：pnpm 10.32 的默认 store 解析到项目内 <repo>/.pnpm-store，
# 是本机工具链产物，不进仓库
.pnpm-store/
renderer/node_modules/
electron/node_modules/
dist_electron/
# 打包时指定了别的输出目录时用的临时目录（dist_electron_xxx/）
dist_electron_*/
npm-debug.log
yarn-error.log

# Python virtualenv and caches
embedding-service/.venv/
embedding-service/__pycache__/
embedding-service/.ruff_cache/
embedding-service/.pytest_cache/
embedding-service/*.pyc
__pycache__/
*.pyc

# Build outputs
renderer/dist/

# 覆盖率报告（vitest --coverage 的产物，给 SonarCloud 用的 lcov 在这下面）
coverage/
**/coverage/

# 开发期数据库（见 src/database/index.ts：开发环境数据不能放进 dist/）
/.data/

# Env and logs
.env
.env.*
*.log

# wrangler 的本地状态（cloud-worker/.wrangler/ 里是本地 D1 副本与构建产物）
# 跟根目录的 /.data/ 一个道理 —— 开发期数据不进仓库
cloud-worker/.wrangler/
cloud-worker/node_modules/

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# 本地代理工作目录（截图、临时脚本等，不进仓库）
.mavis/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# System files
.DS_Store
Thumbs.db
